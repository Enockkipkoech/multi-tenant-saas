# Copy to .env at the REPO ROOT (not packages/db/).
# Prisma CLI resolves .env next to the schema by default, so packages/db's
# scripts use `dotenv -e ../../.env --` to read this file instead.

# --- Shared ---
NODE_ENV=development
PORT=3000

# --- Database ---
# Pooled connection used by the running app (Supabase Supavisor, transaction mode).
# ?pgbouncer=true is REQUIRED: Prisma uses prepared statements by default and
# transaction-mode poolers don't support them (README §7).
DATABASE_URL="postgresql://app_user:password@aws-0-region.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=5"

# Direct, unpooled connection. REQUIRED — `prisma migrate` must bypass the
# pooler, and Prisma errors at schema-validation time if this is unset (P1012).
# Running plain local Postgres with no pooler? Set it to the same value as
# DATABASE_URL (minus ?pgbouncer=true).
DIRECT_URL="postgresql://postgres:password@db.your-project.supabase.co:5432/postgres"

# --- Auth ---
JWT_SECRET=change-me-in-production

# --- Queue (Phase 1: postgres, Phase 2: sqs) ---
QUEUE_DRIVER=postgres
AWS_REGION=af-south-1
SQS_QUEUE_URL=

# --- Twilio ---
TWILIO_AUTH_TOKEN=your-twilio-auth-token

# --- Stripe ---
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx

# --- Plaid ---
PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_ENV=sandbox
