{
  "name": "switchboard",
  "private": true,
  "packageManager": "pnpm@9.0.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "turbo run dev --parallel",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "migrate": "pnpm --filter @switchboard/db migrate:deploy",
    "migrate:dev": "pnpm --filter @switchboard/db migrate:dev",
    "generate": "pnpm --filter @switchboard/db generate",
    "env:check": "dotenv -o -e .env -- node scripts/env-check.mjs",
    "seed": "dotenv -o -e .env -- tsx scripts/seed.mjs",
    "token:tenant": "dotenv -o -e .env -- node scripts/mint-jwt.mjs tenant",
    "token:admin": "dotenv -o -e .env -- node scripts/mint-jwt.mjs admin"
  },
  "devDependencies": {
    "turbo": "^2.1.3",
    "typescript": "^5.6.3",
    "vitest": "^2.1.4",
    "tsx": "^4.19.1",
    "jsonwebtoken": "^9.0.2",
    "dotenv-cli": "^7.4.2"
  }
}